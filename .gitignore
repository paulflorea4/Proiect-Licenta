# --- Environment files: ignore real ones, keep the committed templates ---
.env
.env.*
!.env.example

# --- Java / Maven / Gradle (backend) ---
target/
build/
!**/src/**/build/
.gradle/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.log
hs_err_pid*
replay_pid*

# --- Python (ai-service) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/

# --- Node / Vite (frontend) ---
node_modules/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDEs ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Claude Code local state ---
.claude/settings.local.json
