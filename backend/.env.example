# Copy to backend/.env (never commit it) and fill in the empty values.
# Spring Boot reads these as real OS environment variables: source this file into your
# shell or IDE run configuration before starting the backend (see "Environment variables"
# in the root README). Empty values are secrets that you generate yourself.

# --- Database (names are Spring's own relaxed-binding names, no mapping code needed) ---
# Must match infra/.env: same database, user, password and port as the compose Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/grading
SPRING_DATASOURCE_USERNAME=grading
SPRING_DATASOURCE_PASSWORD=

# --- Auth ---
# Secret used to sign JWTs. Use a long random value, at least 32 bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- AI service ---
AI_SERVICE_URL=http://localhost:8000
# Shared secret the backend sends as `Authorization: Bearer <token>`. Must be exactly the same
# value as AI_SERVICE_TOKEN in ai-service/.env. Use a long random value, e.g. `openssl rand -hex 32`.
AI_SERVICE_TOKEN=

# --- CORS ---
# Comma-separated list of origins allowed to call the API. Default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
