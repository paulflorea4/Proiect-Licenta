# Copy to ai-service/.env (never commit it) and fill in the empty values.
# The service will load this file at startup through pydantic-settings (added in 6.1b).
# Empty values are for you to provide. This service never connects to the database,
# so there are no database variables here.

# --- Gemini ---
# API key for the Gemini API (from Google AI Studio). Only needed once the service calls the real API (6.2a).
GEMINI_API_KEY=
# Name of the Gemini model to use. Deliberately has no default anywhere in the code.
GEMINI_MODEL=

# --- Backend -> AI service authentication ---
# Shared secret: every endpoint except GET /health requires `Authorization: Bearer <token>`.
# Must be exactly the same value as AI_SERVICE_TOKEN in backend/.env. Use a long random value,
# e.g. `openssl rand -hex 32`. The service refuses to start if it is empty (6.1b).
AI_SERVICE_TOKEN=
