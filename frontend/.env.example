# Copy to frontend/.env.local (never commit it) to override for your machine.
# Vite loads .env files from this directory automatically and exposes only VITE_-prefixed
# variables to client code (import.meta.env). Anything here ends up in the browser bundle,
# so never put a secret in this file.

# Base URL of the Spring Boot backend API (no trailing slash). 8080 is Spring Boot's default port.
VITE_API_BASE_URL=http://localhost:8080
